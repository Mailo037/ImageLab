{
  "name": "imagelab",
  "version": "1.0.0",
  "private": false,
  "description": "A local-first, browser-based image editing toolkit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mailo037/ImageLab.git"
  },
  "homepage": "https://github.com/Mailo037/ImageLab#readme",
  "bugs": {
    "url": "https://github.com/Mailo037/ImageLab/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "generate:release": "node scripts/generate-release-manifest.mjs",
    "dev": "npm run generate:release && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run generate:release && bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "exifr": "^7.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "ImageLab"
}
